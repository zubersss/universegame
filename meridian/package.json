{
  "name": "meridian",
  "private": true,
  "version": "1.0.0",
  "description": "MERIDIAN \u2014 The Quiet System. A browser-based 3D space exploration game.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build",
    "build:test": "vite build --mode testhooks --outDir dist-test",
    "preview": "vite preview --port 4173 --strictPort",
    "pretest:e2e": "npm run build && npm run build:test"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "simplex-noise": "4.0.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.30",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
